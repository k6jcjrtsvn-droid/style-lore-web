# Style-LORE — Apache routing + security for GoDaddy cPanel hosting.
# This maps the exact API paths the frontend already calls (e.g.
# /api/posts, /api/auth/signup) onto the matching PHP scripts in api/, so
# the frontend's JavaScript needed zero changes when moving off the old
# Node/Express server.

RewriteEngine On

# --- API routing -------------------------------------------------------
RewriteRule ^api/auth/signup/?$ api/auth_signup.php [L,QSA]
RewriteRule ^api/auth/login/?$ api/auth_login.php [L,QSA]
RewriteRule ^api/account/delete/?$ api/account_delete.php [L,QSA]

RewriteRule ^api/posts/([^/]+)/like/?$ api/post_like.php?id=$1 [L,QSA]
RewriteRule ^api/posts/([^/]+)/comments/?$ api/post_comments.php?id=$1 [L,QSA]
RewriteRule ^api/posts/([^/]+)/report/?$ api/post_report.php?id=$1 [L,QSA]

# A single post by id — DELETE removes it, PUT edits it (see
# api/post_delete.php / api/post_edit.php). Method-conditional since both
# live at the same /api/posts/:id URL, same resource either way.
RewriteCond %{REQUEST_METHOD} =DELETE
RewriteRule ^api/posts/([^/]+)/?$ api/post_delete.php?id=$1 [L,QSA]
RewriteCond %{REQUEST_METHOD} =PUT
RewriteRule ^api/posts/([^/]+)/?$ api/post_edit.php?id=$1 [L,QSA]

RewriteRule ^api/posts/?$ api/posts.php [L,QSA]

RewriteRule ^api/follows/([^/]+)/([^/]+)/?$ api/follow_delete.php?followerId=$1&followingId=$2 [L,QSA]
RewriteRule ^api/follows/?$ api/follows.php [L,QSA]

RewriteRule ^api/profiles/([^/]+)/?$ api/profile.php?id=$1 [L,QSA]
RewriteRule ^api/profile-style/([^/]+)/?$ api/profile_style.php?id=$1 [L,QSA]

RewriteRule ^api/auth/forgot/?$ api/auth_forgot.php [L,QSA]
RewriteRule ^api/auth/reset/?$ api/auth_reset.php [L,QSA]
RewriteRule ^api/auth/verify/?$ api/auth_verify.php [L,QSA]
RewriteRule ^api/auth/resend-verification/?$ api/auth_resend_verification.php [L,QSA]

RewriteRule ^api/admin/moderation/?$ api/admin_moderation.php [L,QSA]
RewriteRule ^api/admin/broadcast/?$ api/admin_broadcast.php [L,QSA]

RewriteRule ^api/checker/photo/?$ api/checker_photo.php [L,QSA]

# --- Community/social features phase: Notifications, DMs, Stories, Groups
RewriteRule ^api/notifications/?$ api/notifications.php [L,QSA]

RewriteRule ^api/device-tokens/?$ api/device_tokens.php [L,QSA]

RewriteRule ^api/conversations/?$ api/conversations.php [L,QSA]
RewriteRule ^api/messages/?$ api/messages.php [L,QSA]

RewriteRule ^api/stories/([^/]+)/view/?$ api/story_view.php?id=$1 [L,QSA]
RewriteRule ^api/stories/?$ api/stories.php [L,QSA]

RewriteRule ^api/groups/([^/]+)/join/?$ api/group_join.php?id=$1 [L,QSA]
RewriteRule ^api/groups/([^/]+)/leave/?$ api/group_leave.php?id=$1 [L,QSA]
RewriteRule ^api/groups/([^/]+)/?$ api/groups.php?id=$1 [L,QSA]
RewriteRule ^api/groups/?$ api/groups.php [L,QSA]

# --- Closet public/hidden visibility (per-item) ---------------------------
RewriteRule ^api/closet/feed/?$ api/closet_feed.php [L,QSA]
RewriteRule ^api/closet/?$ api/closet.php [L,QSA]

# --- Security ------------------------------------------------------------
# config.php holds your database password — never let it be requested
# directly, even though a correctly configured PHP host would execute it
# rather than return its source either way. Defense in depth.
<Files "config.php">
    Require all denied
</Files>
<Files "config.sample.php">
    Require all denied
</Files>
<Files "schema.sql">
    Require all denied
</Files>

# Never let anything under includes/ be requested directly.
RewriteRule ^includes/ - [F,L]

# Sensible caching for static assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType video/mp4 "access plus 7 days"
</IfModule>
