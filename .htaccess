# Style-LORE — Apache routing + security for GoDaddy cPanel hosting.
# This maps the exact API paths the frontend already calls (e.g.
# /api/posts, /api/auth/signup) onto the matching PHP scripts in api/, so
# the frontend's JavaScript needed zero changes when moving off the old
# Node/Express server.

RewriteEngine On

# --- Shared post pages -------------------------------------------------
# /p/<id> renders ONE post for someone who is not signed in, and only when
# its author opted in. noindex is set by p.php itself and in robots.txt.
RewriteRule ^p/([A-Za-z0-9-]+)/?$ p.php?id=$1 [L,QSA]
RewriteRule ^pi/([A-Za-z0-9-]+)/?$ pi.php?id=$1 [L,QSA]

# Clean URLs for the legal and support pages. /privacy and /terms were both
# 404s while the app, the emails and the store listings all say
# "style-lore.com/privacy" out loud; only the .html forms resolved. Apple's
# Support URL field also wants a page that clearly offers help, which is
# what support.html is.
#
# NOTE: this block sits ABOVE the API section on purpose. A RewriteCond binds
# only to the RewriteRule immediately after it, so putting anything between
# "RewriteCond %{REQUEST_METHOD} =OPTIONS" and its rule detaches the
# condition and sends EVERY /api/ request to _cors.php (204 on everything).
# That happened on 2026-09-23; do not move these rules down.
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^support/?$ support.html [L]
# Google Play's App content → Data deletion form wants a URL that explains
# account deletion and works without installing the app. This is that URL.
RewriteRule ^delete-account/?$ support.html [L]

# --- API routing -------------------------------------------------------
# CORS preflights from the native apps (see includes/helpers.php
# cors_headers and api/_cors.php). Must come before the method-conditional
# rules below, which would otherwise 404 an OPTIONS request.
RewriteCond %{REQUEST_METHOD} =OPTIONS
RewriteRule ^api/ api/_cors.php [L]

RewriteRule ^api/auth/signup/?$ api/auth_signup.php [L,QSA]
RewriteRule ^api/auth/login/?$ api/auth_login.php [L,QSA]
RewriteRule ^api/account/delete/?$ api/account_delete.php [L,QSA]

RewriteRule ^api/posts/([^/]+)/like/?$ api/post_like.php?id=$1 [L,QSA]
RewriteRule ^api/posts/([^/]+)/comments/?$ api/post_comments.php?id=$1 [L,QSA]
RewriteRule ^api/posts/([^/]+)/report/?$ api/post_report.php?id=$1 [L,QSA]
RewriteRule ^api/posts/([^/]+)/vote/?$ api/post_vote.php?id=$1 [L,QSA]

# A single post by id — DELETE removes it, PUT edits it (see
# api/post_delete.php / api/post_edit.php). Method-conditional since both
# live at the same /api/posts/:id URL, same resource either way.
RewriteCond %{REQUEST_METHOD} =DELETE
RewriteRule ^api/posts/([^/]+)/?$ api/post_delete.php?id=$1 [L,QSA]
RewriteCond %{REQUEST_METHOD} =PUT
RewriteRule ^api/posts/([^/]+)/?$ api/post_edit.php?id=$1 [L,QSA]

RewriteRule ^api/posts/?$ api/posts.php [L,QSA]

RewriteRule ^api/follows/([^/]+)/([^/]+)/?$ api/follow_delete.php?followerId=$1&followingId=$2 [L,QSA]
RewriteRule ^api/follows/?$ api/follows.php [L,QSA]

# Blocking another member (api/user_block.php). GET lists this account's
# blocks, POST blocks/unblocks. Required by App Store guideline 1.2 —
# without this rewrite the endpoint is a 404 and the Block button does
# nothing, which is exactly what a reviewer would find.
RewriteRule ^api/user_block/?$ api/user_block.php [L,QSA]

RewriteRule ^api/profiles/([^/]+)/?$ api/profile.php?id=$1 [L,QSA]
RewriteRule ^api/profile-style/([^/]+)/?$ api/profile_style.php?id=$1 [L,QSA]

RewriteRule ^api/auth/forgot/?$ api/auth_forgot.php [L,QSA]
RewriteRule ^api/auth/reset/?$ api/auth_reset.php [L,QSA]
RewriteRule ^api/auth/verify/?$ api/auth_verify.php [L,QSA]
RewriteRule ^api/auth/resend-verification/?$ api/auth_resend_verification.php [L,QSA]

RewriteRule ^api/admin/moderation/?$ api/admin_moderation.php [L,QSA]
RewriteRule ^api/admin/broadcast/?$ api/admin_broadcast.php [L,QSA]

RewriteRule ^api/checker/photo/?$ api/checker_photo.php [L,QSA]

RewriteRule ^api/subscription/status/?$ api/subscription_status.php [L,QSA]
# The Premium stylist's written notes on a set of outfits (api/stylist_outfits.php).
RewriteRule ^api/stylist/outfits/?$ api/stylist_outfits.php [L,QSA]
RewriteRule ^api/revenuecat/webhook/?$ api/revenuecat_webhook.php [L,QSA]

# --- Community/social features phase: Notifications, DMs, Stories, Groups
RewriteRule ^api/notifications/?$ api/notifications.php [L,QSA]

RewriteRule ^api/device-tokens/?$ api/device_tokens.php [L,QSA]

RewriteRule ^api/conversations/?$ api/conversations.php [L,QSA]
RewriteRule ^api/messages/?$ api/messages.php [L,QSA]

RewriteRule ^api/stories/([^/]+)/view/?$ api/story_view.php?id=$1 [L,QSA]
RewriteRule ^api/stories/?$ api/stories.php [L,QSA]

RewriteRule ^api/groups/([^/]+)/join/?$ api/group_join.php?id=$1 [L,QSA]
RewriteRule ^api/groups/([^/]+)/leave/?$ api/group_leave.php?id=$1 [L,QSA]
RewriteRule ^api/groups/([^/]+)/?$ api/groups.php?id=$1 [L,QSA]
RewriteRule ^api/groups/?$ api/groups.php [L,QSA]

# --- Closet public/hidden visibility (per-item) ---------------------------
RewriteRule ^api/closet/feed/?$ api/closet_feed.php [L,QSA]
# Styling tips on a public closet item — must precede the bare closet rule.
RewriteRule ^api/closet/tips/?$ api/closet_tips.php [L,QSA]
# The owner's own closet, Hidden items included — must come before the bare
# ^api/closet/?$ rule below or that one would swallow it.
RewriteRule ^api/closet/mine/?$ api/closet_mine.php [L,QSA]
RewriteRule ^api/closet/?$ api/closet.php [L,QSA]

# --- Saved outfits (builder + planner) ------------------------------------
RewriteRule ^api/outfits/?$ api/outfits.php [L,QSA]

# --- Security ------------------------------------------------------------
# config.php holds your database password — never let it be requested
# directly, even though a correctly configured PHP host would execute it
# rather than return its source either way. Defense in depth.
<Files "config.php">
    Require all denied
</Files>
<Files "config.sample.php">
    Require all denied
</Files>
<Files "schema.sql">
    Require all denied
</Files>
# Migration scripts, deploy config, logs and notes ride along in the
# repo — none of them should ever be served.
<FilesMatch "\.(sql|ya?ml|log|md)$">
    Require all denied
</FilesMatch>
<Files "error_log">
    Require all denied
</Files>

# --- Security headers --------------------------------------------------
# HSTS: browsers only ever use HTTPS for this site once they've seen it.
# CSP: scripts, frames and network calls are limited to this site plus the
# handful of hosts the app actually uses (React on cdnjs, MediaPipe on
# jsdelivr + Google storage, Google Analytics/AdSense, Google Fonts, video
# embeds). Even if a script were injected it could not send data anywhere
# else. 'unsafe-inline' is needed because the app itself is one inline
# script; the connect-src/form-action limits are what carry the protection.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    # geolocation=(self): "Today's outfit" asks for the browser's location
    # (only when the person taps "Add weather") so api/weather.php can return
    # today's temperature and rain chance for their area. The coordinates are
    # rounded to ~1km server-side and never stored. Locking this to () — as it
    # was until 2026-09-15 — made the browser refuse the request outright, so
    # the web app always showed "Weather unavailable"; the Android app was
    # unaffected because the WebView doesn't apply this header.
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(self \"https://checkout.stripe.com\")"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://www.googletagservices.com https://adservice.google.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://style-lore.com; connect-src 'self' https://cdn.jsdelivr.net https://storage.googleapis.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://checkout.stripe.com; worker-src 'self' blob:; upgrade-insecure-requests"
</IfModule>

# Never let anything under includes/ be requested directly.
RewriteRule ^includes/ - [F,L]

# The background-removal runtime (vendor/bg/). .wasm must be served as
# application/wasm or the browser refuses to stream-compile it and ONNX
# Runtime falls back to a slower path; .onnx has no registered type, so
# without this Apache guesses and some proxies mangle it.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/octet-stream .onnx
</IfModule>
# Both are version-pinned content that never changes in place -- a year is
# safe, and it means the ~16 MB is fetched exactly once per device.
<IfModule mod_headers.c>
    <FilesMatch "\.(wasm|onnx)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Sensible caching for static assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType video/mp4 "access plus 7 days"
</IfModule>
